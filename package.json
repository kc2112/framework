{
  "name": "@doc-ingest/source",
  "version": "1.0.0",
  "private": true,
  "description": "Nx workspace: document-ingest Step Functions + five Express APIs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "serve": "nx run-many -t serve --parallel=5",
    "serve:stage-1": "nx serve stage-1",
    "serve:stage-2": "nx serve stage-2",
    "serve:stage-3": "nx serve stage-3",
    "serve:stage-4": "nx serve stage-4",
    "serve:stage-5": "nx serve stage-5",
    "serve:stage-6": "nx serve stage-6",
    "serve:stage-7": "nx serve stage-7",
    "serve:local-sfn": "nx serve document-ingest --configuration=local",
    "serve:document-ingest:local": "nx serve document-ingest --configuration=local",
    "serve:document-ingest:dev": "nx serve document-ingest --configuration=dev",
    "serve:document-ingest:test": "nx serve document-ingest --configuration=test",
    "serve:document-ingest:prod": "nx serve document-ingest --configuration=prod",
    "print-config": "nx print-config document-ingest",
    "pack:sfn": "nx pack document-ingest",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jest": "^30.5.1",
    "nx": "^21.6.0"
  }
}
